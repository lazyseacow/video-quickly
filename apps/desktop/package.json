{
  "name": "@video-quickly/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx node_modules/vite/bin/vite.js --host 127.0.0.1",
    "dev:e2e": "node --import tsx node_modules/vite/bin/vite.js build --mode browser-test && node --import tsx node_modules/vite/bin/vite.js preview --mode browser-test",
    "build": "tsc -p tsconfig.json && node --import tsx node_modules/vite/bin/vite.js build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "koffi": "3.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^8.3.5",
    "typescript": "^5.9.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "@video-quickly/contracts": "workspace:*",
    "@video-quickly/video": "workspace:*",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "main": "electron/main.mjs",
  "description": "本地视频创作与编排工作台",
  "author": "Video Quickly",
  "license": "MIT"
}

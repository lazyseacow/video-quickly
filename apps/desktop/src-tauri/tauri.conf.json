{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Quickly",
  "version": "0.1.0",
  "identifier": "net.lazyseacow.video-quickly",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev",
    "beforeBuildCommand": "pnpm --dir ../.. build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Video Quickly", "width": 1480, "height": 960, "minWidth": 1024, "minHeight": 720, "center": true }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**", "$APPLOCALDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../../../.generated/sidecar/": "sidecar/" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false } },
    "category": "Video",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "本地视频创作与编排工作台",
    "license": "MIT"
  }
}
